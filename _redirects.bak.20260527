# Redirect extensionless URLs back to .html versions.
# Google previously indexed pages at non-.html URLs (because the old
# Cloudflare default 308-redirected /foo.html → /foo). After switching to
# html_handling: "none" the .html URLs serve directly and match the sitemap,
# but those previously-indexed extensionless URLs would 404 without these
# explicit redirects.

/area/:slug              /area/:slug.html              301
/area/:slug/             /area/:slug.html              301
/category/:slug          /category/:slug.html          301
/category/:slug/         /category/:slug.html          301
/equipment/:slug         /equipment/:slug.html         301
/equipment/:slug/        /equipment/:slug.html         301
/inventory               /inventory.html               301
/inventory/              /inventory.html               301
